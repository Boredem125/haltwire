# Tripwire -- copy to .env and fill in real values
# NEVER commit .env with real keys

# --- API keys (required) ---
# Gemini key for the attacker (generates red-team cases via Gemini API)
ARENA_ATTACKER_KEY=

# Gemini key for the victim agent (the agent uses this to call Gemini)
# This key's project SHOULD have a spend cap set in GCP console.
ARENA_AGENT_KEY=

# Bearer token for the POST /api/run admin endpoint
ARENA_ADMIN_TOKEN=

# --- Domain (required for GCP with HTTPS) ---
# For GCP: use <ip-with-dashes>.sslip.io  (e.g. 203-0-113-10.sslip.io)
# For local testing: leave commented out (defaults to :80, plain HTTP)
# ARENA_DOMAIN=203-0-113-10.sslip.io

# --- SSH firewall (optional, for gcp_up.sh) ---
# CIDR for SSH access.  Required by gcp_up.sh (no open default).
# FOUNDER_SSH_CIDR=1.2.3.4/32
