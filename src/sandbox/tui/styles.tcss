/* haltwire TUI — demo-quality stylesheet */

Screen {
    background: #1a1a2e;
}

/* ── Header: one compact row ─────────────────────────────── */

#header-bar {
    dock: top;
    height: 1;
    background: #16213e;
    layout: horizontal;
}

#header-title {
    width: auto;
    color: #0fbcf9;
    text-style: bold;
}

#header-path {
    width: 1fr;
    color: #8a8f98;
    padding: 0 1;
}

#header-status {
    width: auto;
    padding: 0 1;
}

#header-ai {
    width: auto;
    padding: 0 1;
}

/* Badge classes (applied to #header-status) */
.badge-protected {
    background: #00b894;
    color: #000000;
    text-style: bold;
}

.badge-frozen {
    background: #d63031;
    color: #ffffff;
    text-style: bold;
}

.badge-tainted {
    background: #fdcb6e;
    color: #000000;
    text-style: bold;
}

/* AI chip classes */
.ai-on {
    color: #a29bfe;
}

.ai-off {
    color: #636e72;
}

.ai-nokey {
    color: #fdcb6e;
}

/* ── Frozen / Tainted banner ─────────────────────────────── */

#frozen-banner {
    height: 1;
    background: #d63031;
    color: #ffffff;
    text-style: bold;
    text-align: center;
}

#tainted-banner {
    height: 1;
    background: #e17055;
    color: #000000;
    text-style: bold;
    text-align: center;
}

.banner-hidden {
    display: none;
}

/* ── Main area ───────────────────────────────────────────── */

#main-area {
    layout: horizontal;
    height: 1fr;
}

#escalation-table {
    width: 2fr;
    height: 1fr;
    scrollbar-size: 0 0;
}

DataTable > .datatable--header {
    background: #2d3436;
    color: #dfe6e9;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #0984e3;
    color: #ffffff;
}

DataTable > .datatable--hover {
    background: #2d3436;
}

#detail-scroll {
    width: 1fr;
    height: 1fr;
    background: #0d1117;
    border-left: solid #2d3436;
}

#detail-pane {
    width: 100%;
    padding: 1 1;
}

#all-clear-box {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: #00b894;
    text-style: bold;
    background: #1a1a2e;
}

/* ── Event feed ──────────────────────────────────────────── */

#event-feed {
    dock: bottom;
    height: 7;
    background: #0d1117;
    border-top: solid #2d3436;
    padding: 0 1;
    overflow-y: auto;
}

/* ── Modals ──────────────────────────────────────────────── */

KeyModal, UnfreezeModal, HelpModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#key-modal-container {
    width: 64;
    height: auto;
    max-height: 16;
    border: thick #0984e3;
    background: #1a1a2e;
    padding: 1 2;
}

#key-modal-title {
    text-style: bold;
    color: #0fbcf9;
}

#key-current {
    color: #8a8f98;
}

#key-status {
    height: 1;
}

.status-ok {
    color: #00b894;
}

.status-err {
    color: #d63031;
}

#unfreeze-modal-container {
    width: 56;
    height: auto;
    max-height: 14;
    border: thick #0984e3;
    background: #1a1a2e;
    padding: 1 2;
}

#unfreeze-title {
    text-style: bold;
    color: #0fbcf9;
}

#unfreeze-status {
    height: 1;
}

#help-container {
    width: 70;
    height: auto;
    max-height: 24;
    border: thick #0984e3;
    background: #1a1a2e;
    padding: 1 2;
    overflow-y: auto;
}

#help-title {
    text-style: bold;
    color: #0fbcf9;
}

/* ── Footer ──────────────────────────────────────────────── */

Footer {
    dock: bottom;
    background: #2d3436;
}

Footer > .footer--key {
    color: #0fbcf9;
    text-style: bold;
    background: #2d3436;
}

Footer > .footer--description {
    color: #b2bec3;
}
